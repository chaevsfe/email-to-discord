{
    "imap_server": "imap.gmail.com",
    "imap_port": 993,
    "email_address": "your-receiving-email@gmail.com",
    "email_password": "your-app-password",
    "folder": "INBOX",
    "search_criteria": "UNSEEN",
    "mark_as_read": true,
    "poll_interval": 60,

    "discord_webhook": "https://discord.com/api/webhooks/DEFAULT_WEBHOOK",
    "subject_filters": [
        "Your Netflix temporary access code",
        "Your sign-in code",
        "A new device is using your account",
        "Time Sensitive: Your One-Time HBO Max Code",
        "Your one-time passcode"
    ],
    "templates": {
        "netflix_access": {
            "subject_contains": "Your Netflix temporary access code",
            "emoji": "🎬",
            "title": "Netflix Access Code Requested",
            "color": 14423100,
            "link_patterns": [
                "<a[^>]+href=[\"']([^\"']+)[\"'][^>]*>\\s*Get\\s*Code"
            ],
            "info_pattern": "Requested by\\s+(\\w+)\\s+from\\s+(?:a\\s+)?(.+?)\\s+at\\s+(.+?)(?:\n|Get Code)"
        },
        "netflix_signin": {
            "subject_contains": "Your sign-in code",
            "emoji": "🎬",
            "title": "Netflix Sign-In Code",
            "color": 14423100,
            "code_pattern": "Enter this code to sign in\\s+(\\d{4,6})"
        },
        "netflix_new_device": {
            "subject_contains": "A new device is using your account",
            "emoji": "🎬",
            "title": "Netflix New Device Sign-In",
            "color": 3066993,
            "edit_template": ["netflix_signin", "netflix_access"],
            "edit_field_name": "✅ Signed In",
            "edit_color": 3066993,
            "info_pattern": "Device\\s+(?P<device>[^\\n]+)\\s+Location\\s+(?P<location>[^\\n]+)[\\s\\S]*?Time\\s+(?P<time>[^\\n]+)"
        },
        "hbo": {
            "subject_contains": "Time Sensitive: Your One-Time HBO Max Code",
            "emoji": "📺",
            "title": "HBO Max Code Requested",
            "color": 9932887
        },
        "disney": {
            "subject_contains": "Your one-time passcode",
            "emoji": "🏰",
            "title": "Disney+ Code Requested",
            "color": 1738207
        }
    }
}
