{
    "imap_server": "imap.gmail.com",
    "imap_port": 993,
    "email_address": "your-receiving-email@gmail.com",
    "email_password": "your-app-password",
    "folder": "INBOX",
    "search_criteria": "UNSEEN",
    "mark_as_read": true,
    "poll_interval": 60,

    "discord_webhook": "https://discord.com/api/webhooks/DEFAULT_WEBHOOK",

    "subject_filters": ["netflix", "hbo", "disney", "access code", "verification"],

    "templates": {
        "netflix": {
            "subject_contains": "netflix",
            "emoji": "🎬",
            "title": "Netflix Access Code Requested",
            "color": 14423100,
            "webhook": "https://discord.com/api/webhooks/NETFLIX_CHANNEL_WEBHOOK",
            "link_patterns": [
                "<a[^>]+href=[\"']([^\"']*netflix[^\"']*)[\"'][^>]*>\\s*Get Code",
                "<a[^>]+href=[\"']([^\"']+)[\"'][^>]*>\\s*Get\\s*Code\\s*</a>"
            ],
            "info_pattern": "Requested by\\s+(\\w+)\\s+from\\s+(?:a\\s+)?(.+?)\\s+at\\s+(.+?)(?:\\n|Get Code)"
        },
        "hbo": {
            "subject_contains": "hbo",
            "emoji": "📺",
            "title": "HBO Max Code Requested",
            "color": 9932887,
            "webhook": "https://discord.com/api/webhooks/HBO_CHANNEL_WEBHOOK"
        },
        "disney": {
            "subject_contains": "disney",
            "emoji": "🏰",
            "title": "Disney+ Code Requested",
            "color": 1738207
        }
    }
}
